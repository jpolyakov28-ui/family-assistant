# Telegram Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Supabase project credentials (Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Default timezone for users (can be overridden per-user)
DEFAULT_TZ=Europe/Moscow

# Comma-separated Telegram IDs of family members allowed to use the bot.
# Leave empty to allow anyone who runs /start (not recommended).
ALLOWED_TELEGRAM_IDS=
